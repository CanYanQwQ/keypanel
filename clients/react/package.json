{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@cardkey/react-proxy-client",
  "version": "0.1.0",
  "private": true,
  "description": "React browser client for the CardKey protected proxy contract",
  "type": "module",
  "files": [
    "dist",
    "src",
    "README.md",
    "tsconfig.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/client.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "typescript": "^5.6.0"
  }
}
